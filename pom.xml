<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Наследуем от Spring Boot: он задаёт версии сотен библиотек (BOM) и настройки плагинов -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version> <!-- подставьте актуальную 4.x из start.spring.io (см. Приложение A) -->
    <relativePath/>
  </parent>

  <groupId>world.sirius</groupId>
  <artifactId>sirius</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging> <!-- родитель-агрегатор: сам не собирается в jar -->

  <modules>
    <module>libs/sirius-events</module>
    <module>services/auth-service</module>
    <module>services/order-service</module>
    <module>services/notification-service</module>
    <module>services/ops-service</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <docker-java.version>3.7.1</docker-java.version> <!-- проверьте актуальную в Maven Central -->
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Внутренняя библиотека событий: одна версия на все сервисы -->
      <dependency>
        <groupId>world.sirius</groupId>
        <artifactId>sirius-events</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
